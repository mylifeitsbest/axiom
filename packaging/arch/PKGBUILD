# Maintainer: Axiom contributors <192708983+mylifeitsbest@users.noreply.github.com>
# Имя `axiom-browser`, чтобы не путать с системой компьютерной алгебры Axiom.
pkgname=axiom-browser
_repo=axiom
pkgver=0.5.2
pkgrel=1
pkgdesc='Лёгкий браузер на Rust: минимум памяти, DuckDuckGo и панель Google AI Mode'
arch=('x86_64')
url='https://github.com/mylifeitsbest/axiom'
license=('custom')
# Библиотеки — по DT_NEEDED бинарника (libdbus-1 тянет tao); xdg-utils и curl — внешние команды.
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'glib2' 'cairo' 'gdk-pixbuf2' 'dbus' 'gcc-libs' 'glibc'
         'xdg-utils' 'hicolor-icon-theme' 'curl')
makedepends=('cargo')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$_repo-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_repo-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "$_repo-$pkgver"
  install -Dm755 target/release/axiom "$pkgdir/usr/bin/axiom-browser"
  install -Dm644 packaging/linux/axiom-browser.desktop "$pkgdir/usr/share/applications/axiom-browser.desktop"
  install -Dm644 assets/logo.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/axiom-browser.svg"
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "assets/linux/axiom-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/axiom-browser.png"
  done
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
