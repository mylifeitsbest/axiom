{
  "api": 1,
  "id": "quiet-youtube",
  "name": "Тихий YouTube",
  "version": "1.0.0",
  "description": "Пример плагина на стилях: прячет Shorts и, если хотите, комментарии.",
  "author": "Axiom",
  "homepage": "https://github.com/mylifeitsbest/axiom/tree/main/examples/plugins/quiet-youtube",
  "content_scripts": [
    { "matches": ["youtube.com"], "css": ["quiet.css"], "js": ["quiet.js"], "run_at": "start" }
  ],
  "settings": [
    { "key": "shorts", "type": "toggle", "label": "Прятать Shorts", "default": true },
    {
      "key": "comments", "type": "choice", "label": "Комментарии под видео",
      "options": [
        { "value": "show", "label": "Показывать" },
        { "value": "hide", "label": "Прятать" }
      ],
      "default": "show"
    }
  ]
}
