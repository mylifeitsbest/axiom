# Maintainer: Axiom contributors <192708983+mylifeitsbest@users.noreply.github.com>
# Готовый бинарник из релиза на GitHub (архив axiom-linux-x86_64.tar.gz).
# Сборка из исходников — packaging/arch/PKGBUILD (пакет axiom-browser).
# После правки: makepkg --printsrcinfo > .SRCINFO (CI сверяет их).
pkgname=axiom-browser-bin
_pkgname=axiom-browser
pkgver=0.6.1
pkgrel=1
pkgdesc='Lightweight Rust browser with DuckDuckGo and a Google AI Mode side panel (prebuilt binary)'
arch=('x86_64')
url='https://github.com/mylifeitsbest/axiom'
license=('MIT')
# Видео: H.264/HEVC/AAC (mp4) декодирует gst-libav, VP8/VP9 — gst-plugins-good. Без них
# WebKitGTK показывает вместо видео чёрный прямоугольник.
# Библиотеки — по DT_NEEDED бинарника (libdbus-1 тянет tao); xdg-utils и curl — внешние команды.
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'glib2' 'cairo' 'gdk-pixbuf2' 'dbus' 'gcc-libs' 'glibc'
         'xdg-utils' 'hicolor-icon-theme' 'curl' 'gst-plugins-good' 'gst-libav')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
# Бинарник в архиве уже без отладочных символов.
options=('!strip' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/axiom-linux-x86_64.tar.gz")
sha256sums=('443c00c2b1895fc2ddad1a1801c32c539e0acc764ac190cf64673bfea39d21cc')

package() {
  cd axiom
  install -Dm755 axiom-browser "$pkgdir/usr/bin/axiom-browser"
  install -Dm644 axiom-browser.desktop "$pkgdir/usr/share/applications/axiom-browser.desktop"
  install -Dm644 icons/axiom-browser.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/axiom-browser.svg"
  local size
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "icons/axiom-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/axiom-browser.png"
  done
  install -Dm644 README.md "$pkgdir/usr/share/doc/$_pkgname/README.md"
  # В архивах до 0.6.2 файла лицензии ещё не было.
  if [ -f LICENSE ]; then
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  fi
}
