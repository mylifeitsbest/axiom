# Caddy получит HTTPS-сертификат на это имя автоматически.
# __DOMAIN__ подставит deploy.sh (по умолчанию 179-254-172-240.sslip.io —
# это DNS, который указывает на IP сервера, отдельный домен не нужен).
__DOMAIN__ {
	encode gzip
	# Отчёт об ошибке — до 64 КБ (сам stats.py больше не примет).
	handle /r {
		request_body {
			max_size 80KB
		}
		reverse_proxy 127.0.0.1:8787
	}
	# Ответ человеку со страницы отчёта — до 2000 символов (в форме — до 32 КБ).
	handle /d/* {
		request_body {
			max_size 40KB
		}
		reverse_proxy 127.0.0.1:8787
	}
	# Отчёт с файлами (снимки, видео): до 50 МБ файлов и 64 КБ отчёта.
	handle /rf {
		request_body {
			max_size 52MiB
		}
		reverse_proxy 127.0.0.1:8787
	}
	# Пинг — меньше 200 байт; большие тела не пропускаем дальше Caddy.
	handle {
		request_body {
			max_size 4KB
		}
		reverse_proxy 127.0.0.1:8787
	}
}
